{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory naming request, independent of CAD and internal R revision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "enum": [
        "S",
        "X"
      ]
    },
    "material": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_一-鿿]+$"
    },
    "thickness": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^([0-9]{8}|[0-9]{4}[-/][0-9]{2}[-/][0-9]{2})$"
    },
    "number": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,4}$"
        }
      ]
    },
    "factory_version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_code": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "material_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_一-鿿]+$"
    },
    "material_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_description": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_一-鿿]+$"
        },
        "confirmed": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        }
      }
    }
  },
  "$comment": "Missing formal fields produce UNNAMED_PENDING_CONFIRMATION, never guessed. Calendar/source material/thickness/upgrade checks are in factory_naming.resolve. Factory owns numbering uniqueness/reset. R12 accepts explicit material_code and separately confirmed exact source-description mapping. Unknown/ambiguous grades are not inferred."
}