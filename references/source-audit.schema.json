{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Existing STEP audit configuration2.5.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "material": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "material_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "K_ANSI": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "K_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "K_status": {
      "enum": [
        "unknown",
        "requested",
        "assumed",
        "measured"
      ]
    },
    "diagnostic_K_ANSI": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "diagnose_invalid": {
      "type": "boolean"
    },
    "try_non_design_repair": {
      "type": "boolean"
    },
    "max_root_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "part_roles": {
      "type": "object",
      "patternProperties": {
        "^SOLID_[0-9]+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "adjacent_hole_gap_limit_mm": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_ids",
        "lid_id",
        "up_axis"
      ],
      "properties": {
        "body_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SOLID_[0-9]+$"
          }
        },
        "lid_id": {
          "type": "string",
          "pattern": "^SOLID_[0-9]+$"
        },
        "up_axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        },
        "up_sign": {
          "enum": [
            -1,
            1
          ]
        }
      }
    }
  }
}
